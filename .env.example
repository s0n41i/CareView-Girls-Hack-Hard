# Shared secret the Genesis Mini sends as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 24
DEVICE_TOKEN=

# Probe calibration (raw 12-bit ADC). Measure yours: see firmware/README.md
SENSOR_DRY_RAW=3200
SENSOR_WET_RAW=1300

# Detection thresholds (moisture %)
SENSOR_WET_ON_PCT=35
SENSOR_WET_OFF_PCT=15
SENSOR_CONFIRM_READINGS=2
